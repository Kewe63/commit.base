# Public build-time settings only. NEVER put a private key in VITE_*.
# Deploy and verify a NEW vault first; blank addresses disable transactions.
VITE_VAULT_ADDRESS_BASE_SEPOLIA=
# Decimal block number of that vault's deployment (not a timestamp).
VITE_DEPLOYMENT_BLOCK_BASE_SEPOLIA=0

# Real-money Base mainnet is disabled unless explicitly enabled.
VITE_ENABLE_MAINNET=false
VITE_VAULT_ADDRESS_BASE=
VITE_DEPLOYMENT_BLOCK_BASE=0

# Optional PUBLIC RPC URLs. Blank uses the chain default.
VITE_RPC_URL_BASE_SEPOLIA=
VITE_RPC_URL_BASE=
