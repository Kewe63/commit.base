{
  "name": "commit-base-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "CommitmentVault smart contract for commit.base",
  "engines": { "node": ">=22 <25" },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test --network hardhat",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network baseSepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network baseMainnet",
    "verify:sepolia": "hardhat verify --network baseSepolia",
    "verify:mainnet": "hardhat verify --network baseMainnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "4.0.0",
    "hardhat": "2.28.6",
    "solc": "0.8.20"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "dotenv": "16.6.1"
  }
}
